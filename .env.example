# Canonical origin used for metadata, sitemap, and structured data.
# On Vercel this falls back to the project's production domain when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Search indexing stays off until PowerSetter approves a public launch.
# Even when true, only Vercel production deployments are indexable; previews never are.
NEXT_PUBLIC_ALLOW_INDEXING=false
